local currentPopup
local function closePopup()
	local p = currentPopup
	if not p then return end
	currentPopup = nil
	p.frame.Visible = false
	Catcher.Visible = false
	if p.conn then p.conn:Disconnect() end
	if p.onClose then p.onClose() end
end
connect(Catcher.MouseButton1Click, closePopup)

local function openPopup(frame, anchor, onClose)
	closePopup()
	local fw, fh = frame.Size.X.Offset, frame.Size.Y.Offset
	local function place()
		if not anchor.Parent then closePopup() return end
		local sc = WinScale.Scale -- posições do popup vivem dentro do Window (escalado)
		local a = (anchor.AbsolutePosition - Window.AbsolutePosition) / sc
		local winSize = Window.AbsoluteSize / sc
		local x = a.X + anchor.AbsoluteSize.X / sc - fw
		local y = a.Y + anchor.AbsoluteSize.Y / sc + 4
		if y + fh > winSize.Y - 6 then y = a.Y - fh - 4 end
		x = math.clamp(x, 6, math.max(6, winSize.X - fw - 6))
		frame.Position = UDim2.fromOffset(x, math.max(6, y))
	end
	frame.Visible = true
