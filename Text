--//============================= BUSCA / FILTRO ================================
local function applyFilter(query)
	query = string.lower(query or "")
	for _, tab in ipairs(tabs) do
		for _, holder in ipairs(tab.Page:GetChildren()) do
			if holder:IsA("Frame") then
				if query == "" then
					holder.Visible = true
					for _, row in ipairs(holder:GetChildren()) do
						if row:IsA("Frame") then row.Visible = true end
					end
				else
					local any = false
					for _, row in ipairs(holder:GetChildren()) do
						local st = row:IsA("Frame") and row:GetAttribute("SearchText")
						if st then
							local match = string.find(string.lower(st), query, 1, true) ~= nil
							row.Visible = match
							any = any or match
						end
					end
					holder.Visible = any
				end
			end
		end
	end
end
connect(SearchBox:GetPropertyChangedSignal("Text"), function() applyFilter(SearchBox.Text) end)

