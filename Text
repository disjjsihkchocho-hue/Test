--//=============== DETECÇÃO AUTOMÁTICA DO NOME REAL DO JOGO ====================
--  Ordem de tentativa (o nome original, sem tradução, tem prioridade):
--   1) game.Name                                  (nome original do servidor, instantâneo)
--   2) API pública de jogos via request do executor (nome oficial do universo)
--   3) MarketplaceService:GetProductInfo           (fallback; pode vir traduzido)
--  O nome é limpo: remove [tags], (parênteses), emojis e espaços extras.
task.spawn(function()
	local MarketplaceService = game:GetService("MarketplaceService")

	local function stripSymbols(str)
		local ok, result = pcall(function()
			local out = {}
			for _, cp in utf8.codes(str) do
				local sym = (cp >= 0x1F000 and cp <= 0x1FAFF) -- emojis
					or (cp >= 0x2190 and cp <= 0x2BFF)         -- setas / símbolos / dingbats
					or cp == 0xFE0F or cp == 0x200D            -- seletor de emoji / joiner
				if not sym then table.insert(out, utf8.char(cp)) end
			end
			return table.concat(out)
		end)
		return ok and result or str
	end
	local function cleanName(n)
		local c = n:gsub("%b[]", "")
		c = c:gsub("%b()", "")
		c = c:gsub("%b{}", "")
		c = stripSymbols(c)
		c = c:gsub("%s+", " ")
		c = c:gsub("^[%s%-|:]+", "")
		c = c:gsub("[%s%-|:]+$", "")
		return c ~= "" and c or n
	end

	local invalid = { ["Game"] = true, ["Place"] = true, ["Place1"] = true, ["Baseplate"] = true, ["Untitled Game"] = true }
	local applied = false
	local function apply(n)
		if type(n) == "string" and n ~= "" and not invalid[n] then
			Library:SetGameName(cleanName(n))
			applied = true
			return true
		end
		return false
	end

	-- 1) nome do servidor (instantâneo)
	apply(game.Name)

	-- 2) API pública (nome oficial do universo, sem tradução)
	local req = (syn and syn.request) or (http and http.request) or http_request or request or (fluxus and fluxus.request)
	if req and game.GameId ~= 0 then
		for _, host in ipairs({ "games.roproxy.com", "games.roblox.com" }) do
			local ok, res = pcall(function()
				return req({ Url = "https://" .. host .. "/v1/games?universeIds=" .. tostring(game.GameId), Method = "GET" })
			end)
			if ok and type(res) == "table" and res.Body then
				local ok2, data = pcall(function() return HttpService:JSONDecode(res.Body) end)
				local entry = ok2 and type(data) == "table" and type(data.data) == "table" and data.data[1]
				if entry and apply(entry.name) then break end
			end
		end
	end

	-- 3) fallback: GetProductInfo (com tentativas)
	if not applied then
		for attempt = 1, 4 do
			local ok, info = pcall(function() return MarketplaceService:GetProductInfo(game.PlaceId) end)
			if ok and type(info) == "table" and apply(info.Name) then break end
			task.wait(attempt)
		end
	end

	if not applied then Library:SetGameName("Jogo " .. tostring(game.PlaceId)) end
end)

