		end

		local function buildOptions()
			for _, c in ipairs(list:GetChildren()) do if c:IsA("TextButton") then c:Destroy() end end
			for i, opt in ipairs(options) do
				local isSel = (opt == selected)
				local b = make("TextButton", {
					BackgroundColor3 = isSel and Config.SurfaceHover or Config.Surface,
					Font = Config.FontBody, Text = tostring(opt),
					TextColor3 = isSel and Config.Accent or Config.Text, TextSize = 12,
					AutoButtonColor = false, Size = UDim2.new(1, -6, 0, 22), LayoutOrder = i, ZIndex = 3, Parent = list,
				})
				corner(b, UDim.new(0, 4))
				b.MouseEnter:Connect(function() tween(b, 0.1, { BackgroundColor3 = Config.SurfaceHover }) end)
				b.MouseLeave:Connect(function()
					tween(b, 0.1, { BackgroundColor3 = (opt == selected) and Config.SurfaceHover or Config.Surface })
				end)
				b.MouseButton1Click:Connect(function()
					setSelected(opt, true)
					closePopup()
				end)
