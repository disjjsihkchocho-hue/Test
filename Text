local function fmtUptime(sec)
	local d = math.floor(sec / 86400)
	local h = math.floor(sec % 86400 / 3600)
	local m = math.floor(sec % 3600 / 60)
	local x = sec % 60
	if d > 0 then return string.format("%dd %02d:%02d:%02d", d, h, m, x) end
	return string.format("%02d:%02d:%02d", h, m, x)
end
function Library:GetUptime() return os.time() - openedAt end          -- segundos
function Library:GetUptimeText() return fmtUptime(os.time() - openedAt) end
