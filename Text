			return
		elseif island.Pos == Vector3.zero then
			Library:Notify("Teleport", island.Name .. ": defina a posição na tabela Islands.", 4, "warning")
			return
		end
		local _, root = getCharacter()
		local ok, err = pcall(function() (root :: BasePart).CFrame = CFrame.new(island.Pos) end)
		Library:Notify("Teleport", ok and ("Indo para " .. island.Name) or tostring(err), 3,
