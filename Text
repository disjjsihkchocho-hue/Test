local function makeDraggable(handle)
	local dragStart, startPos
	dragify(handle,
		function(input)
			dragStart = input.Position
			startPos = Window.AbsolutePosition - ScreenGui.AbsolutePosition
		end,
		function(input)
			if not dragStart then return end
			local d = input.Position - dragStart
			local area = ScreenGui.AbsoluteSize
			local size = Window.AbsoluteSize
			-- sempre sobram 60px da janela visíveis na tela
			local x = math.clamp(startPos.X + d.X, 60 - size.X, area.X - 60)
			local y = math.clamp(startPos.Y + d.Y, 0, math.max(0, area.Y - TOP))
			Window.Position = UDim2.fromOffset(x, y)
		end)
end

