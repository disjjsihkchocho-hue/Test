	---- Keybind: callback dispara AO PRESSIONAR a tecla; `changed` dispara ao trocar o bind ----
	function SectionAPI:Keybind(text, default, callback, changed)
		local row = baseRow("Keybind", text)
		rowLabel(row, text, 90)
		local bound = default -- EnumItem ou nil
		local listening = false
		local box = make("TextButton", {
			BackgroundColor3 = Config.Background, Font = Config.Font,
			Text = bound and bound.Name or "None", TextColor3 = Config.Accent, TextSize = 12,
			AutoButtonColor = false, AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -4, 0.5, 0),
			Size = UDim2.new(0, 80, 0, 24), Parent = row,
		})
		corner(box, UDim.new(0, 5))
		local st = stroke(box, Config.Border, 1)
		registerAccent(box, "TextColor3")

		local function refresh() box.Text = bound and bound.Name or "None" end
		connect(box.MouseButton1Click, function()
			listening = true; box.Text = "..."
			tween(st, 0.15, { Color = Config.Accent })
		end)
		connect(UserInputService.InputBegan, function(input, gpe)
			if listening then
				if input.UserInputType == Enum.UserInputType.Keyboard then
					listening = false
					bound = (input.KeyCode ~= Enum.KeyCode.Escape) and input.KeyCode or nil -- ESC limpa
					refresh()
					tween(st, 0.15, { Color = Config.Border })
					if changed then task.spawn(changed, bound) end
				end
				return
			end
			if gpe or not bound or UserInputService:GetFocusedTextBox() then return end
			if input.KeyCode == bound and callback then task.spawn(callback, bound) end
		end)

		local api = {
			Set = function(v, silent)
				if type(v) == "string" then
					local ok, kc = pcall(function() return Enum.KeyCode[v] end)
					v = ok and kc or nil
				end
				bound = v; refresh()
				if not silent and changed then task.spawn(changed, bound) end
			end,
			Get = function() return bound end,
		}
		registerControl(key(text), api)
		return api
	end

