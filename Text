local AccentInsts = {}
local ThemedButtons = {}

local function registerAccent(inst, prop)
	table.insert(AccentInsts, { inst = inst, prop = prop or "BackgroundColor3" })
end

local Library = {}

function Library:SetAccent(c3)
	Config.Accent = c3
	Config.AccentDim = c3:Lerp(Color3.new(0, 0, 0), 0.3)
	for i = #AccentInsts, 1, -1 do
		local a = AccentInsts[i]
		if a.inst.Parent then
			tween(a.inst, 0.3, { [a.prop] = c3 })
		else
			table.remove(AccentInsts, i)
		end
	end
	for _, b in ipairs(ThemedButtons) do
		if b.Parent then tween(b, 0.3, { BackgroundColor3 = c3 }) end
	end
	-- (toggles ficam brancos/pretos, não seguem o accent)
end

