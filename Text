	---- Toggle: ligado = BRANCO, desligado = PRETO ----
	function SectionAPI:Toggle(text, default, callback)
		local row = baseRow("Toggle", text)
		rowLabel(row, text, 54)
		local state = default and true or false
		local track = make("Frame", {
			BackgroundColor3 = state and Config.ToggleOn or Config.ToggleOff,
			AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -4, 0.5, 0),
			Size = UDim2.new(0, 38, 0, 20), Parent = row,
		})
		corner(track, UDim.new(1, 0))
		local trackStroke = stroke(track, state and Config.ToggleOn or Config.Border, 1)
		local knob = make("Frame", {
			BackgroundColor3 = state and Config.KnobOn or Config.KnobOff, Size = UDim2.new(0, 14, 0, 14),
			Position = state and UDim2.new(1, -17, 0.5, -7) or UDim2.new(0, 3, 0.5, -7), Parent = track,
		})
		corner(knob, UDim.new(1, 0))

		local function apply(v, fire)
			state = v and true or false
			tween(track, 0.18, { BackgroundColor3 = state and Config.ToggleOn or Config.ToggleOff })
			tween(trackStroke, 0.18, { Color = state and Config.ToggleOn or Config.Border })
			tween(knob, 0.18, {
				BackgroundColor3 = state and Config.KnobOn or Config.KnobOff,
				Position = state and UDim2.new(1, -17, 0.5, -7) or UDim2.new(0, 3, 0.5, -7),
