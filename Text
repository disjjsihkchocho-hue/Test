		end
		local hit = make("TextButton", { BackgroundTransparency = 1, Text = "", Size = UDim2.new(1, 0, 1, 0), Parent = row })
		connect(hit.MouseButton1Click, function() apply(not state, true) end)

		local api = {
			Set = function(v, silent) apply(v, not silent) end,
			Get = function() return state end,
		}
		registerControl(key(text), api)
		return api
	end

	---- Slider (com `step` opcional e proteção contra max == min) ----
	function SectionAPI:Slider(text, min, max, default, callback, step)
		min, max = min or 0, max or 100
		if max <= min then max = min + 1 end
		step = (step and step > 0) and step or 1
		local function snap(v)
			v = math.floor((v - min) / step + 0.5) * step + min
			return tonumber(string.format("%.4f", math.clamp(v, min, max)))
		end
		local value = snap(default or min)

		local row = baseRow("Slider", text, 46)
		make("TextLabel", {
			BackgroundTransparency = 1, Font = Config.FontBody, Text = text,
			TextColor3 = Config.Text, TextSize = 13, TextXAlignment = Enum.TextXAlignment.Left,
			TextTruncate = Enum.TextTruncate.AtEnd,
			Position = UDim2.new(0, 4, 0, 0), Size = UDim2.new(1, -64, 0, 20), Parent = row,
		})
		local valueLabel = make("TextLabel", {
			BackgroundTransparency = 1, Font = Config.Font, Text = tostring(value),
			TextColor3 = Config.Accent, TextSize = 13, TextXAlignment = Enum.TextXAlignment.Right,
			AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -4, 0, 0),
			Size = UDim2.new(0, 56, 0, 20), Parent = row,
		})
		registerAccent(valueLabel, "TextColor3")
		-- área de clique maior que a barra visual (melhor no toque)
		local hit = make("Frame", {
			BackgroundTransparency = 1, Position = UDim2.new(0, 0, 0, 22), Size = UDim2.new(1, 0, 0, 22), Parent = row,
		})
		local track = make("Frame", {
			BackgroundColor3 = Config.Border, AnchorPoint = Vector2.new(0, 0.5),
			Position = UDim2.new(0, 4, 0.5, 0), Size = UDim2.new(1, -8, 0, 6), Parent = hit,
		})
		corner(track, UDim.new(1, 0))
		local rel0 = (value - min) / (max - min)
		local fill = make("Frame", { BackgroundColor3 = Config.Accent, Size = UDim2.new(rel0, 0, 1, 0), Parent = track })
		corner(fill, UDim.new(1, 0))
		registerAccent(fill)
		local knob = make("Frame", {
			BackgroundColor3 = Color3.fromRGB(245, 245, 245), AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(rel0, 0, 0.5, 0), Size = UDim2.new(0, 14, 0, 14), ZIndex = 3, Parent = track,
		})
		corner(knob, UDim.new(1, 0))

		local function setValue(v, fire)
			local old = value
			value = snap(v)
			local rel = (value - min) / (max - min)
			fill.Size = UDim2.new(rel, 0, 1, 0)
			knob.Position = UDim2.new(rel, 0, 0.5, 0)
			valueLabel.Text = tostring(value)
			if fire and callback then task.spawn(callback, value) end
			return old ~= value
		end
		local function fromInput(input)
			local rel = math.clamp((input.Position.X - track.AbsolutePosition.X) / math.max(1, track.AbsoluteSize.X), 0, 1)
			local old = value
			local newV = snap(min + rel * (max - min))
			if newV ~= old then setValue(newV, true) end
		end
		dragify(hit, fromInput, fromInput)

		local api = {
			Set = function(v, silent) setValue(tonumber(v) or min, not silent) end,
			Get = function() return value end,
		}
		registerControl(key(text), api)
		return api
	end

