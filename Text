	-- liga/desliga uma feature e sincroniza todos os toggles que a espelham
	local function setActive(key: string, on: boolean)
		on = on and true or false
		if State.Destroyed or State.Active[key] == on then return end
		State.Active[key] = on
		local f = Main[key]
		if not on and f and f.OnStop then pcall(f.OnStop) end
		for _, id in ipairs(Groups[key] or {}) do
			local ref = Refs[id]
			if ref and ref.Get() ~= on then ref.Set(on, true) end -- silencioso: sem recursão
		end
		if f and f.Notify then
			Library:Notify(f.Name, on and "Ativado" or "Desativado", 2, on and "success" or "warning")
		end
		if f and f.OnChange then task.spawn(f.OnChange, on) end
	end

	local function disableAll()
		for key in pairs(State.Active) do setActive(key, false) end
		Library:Notify("Hub", "Todas as features desligadas.", 3, "warning")
