-- kind (opcional): "success" | "warning" | "error" — padrão usa o accent do tema
local MAX_NOTIFY = 5

function Library:Notify(title, text, duration, kind)
	duration = duration or 3
	-- mantém no máximo MAX_NOTIFY: a mais antiga (primeira filha) sai
	while #NotifyHolder:GetChildren() - 1 >= MAX_NOTIFY do
		local oldest = NotifyHolder:FindFirstChildWhichIsA("Frame")
		if not oldest then break end
		oldest:Destroy()
	end
	local note = make("Frame", {
		BackgroundColor3 = Config.Surface, BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, Parent = NotifyHolder,
	})
	corner(note, UDim.new(0, 8))
	local st = stroke(note, Config.Border, 1)
	st.Transparency = 1

	local bar = make("Frame", {
		BackgroundColor3 = NotifyColors[kind] or Config.Accent, BackgroundTransparency = 1,
		Position = UDim2.new(0, 6, 0, 8), Size = UDim2.new(0, 3, 1, -16), Parent = note,
	})
	corner(bar, UDim.new(1, 0))
	if not NotifyColors[kind] then registerAccent(bar) end

	make("TextLabel", {
		BackgroundTransparency = 1, TextTransparency = 1, Font = Config.Font, Text = title or "Notificação",
		TextColor3 = Config.Text, TextSize = 13, TextXAlignment = Enum.TextXAlignment.Left,
		Position = UDim2.new(0, 18, 0, 8), Size = UDim2.new(1, -28, 0, 18), Parent = note,
	})
	local body = make("TextLabel", {
		BackgroundTransparency = 1, TextTransparency = 1, Font = Config.FontBody, Text = text or "",
		TextColor3 = Config.TextDim, TextSize = 12, TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top,
		Position = UDim2.new(0, 18, 0, 26), Size = UDim2.new(1, -28, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y, Parent = note,
	})
	padding(body, 0, 0, 0, 10) -- respiro inferior

	local function fade(toTransparency, time)
		tween(note, time, { BackgroundTransparency = toTransparency })
		tween(st, time, { Transparency = toTransparency })
		tween(bar, time, { BackgroundTransparency = toTransparency })
		for _, c in ipairs(note:GetChildren()) do
			if c:IsA("TextLabel") then tween(c, time, { TextTransparency = toTransparency }) end
		end
	end
	fade(0, 0.25)
	task.delay(duration, function()
		if not note.Parent then return end
		fade(1, 0.3)
		task.wait(0.35)
		note:Destroy()
	end)
end

--//===================== SALVAR / CARREGAR CONFIGS =============================
function Library:SaveConfig(filename)
	filename = filename or Config.ConfigFile
	local data = { Accent = { Config.Accent.R, Config.Accent.G, Config.Accent.B }, Controls = {} }
	for k, api in pairs(ControlRegistry) do
		local ok, val = pcall(api.Get)
		if ok and val ~= nil then
			if typeof(val) == "Color3" then
				data.Controls[k] = { __color = true, r = val.R, g = val.G, b = val.B }
			elseif typeof(val) == "EnumItem" then
				data.Controls[k] = { __enum = true, name = val.Name }
			else
				data.Controls[k] = val
			end
		end
	end
	local ok = pcall(function() writefile(filename, HttpService:JSONEncode(data)) end)
	if ok then
		self:Notify("Config salva", "Suas configurações foram salvas.", 3, "success")
	else
		self:Notify("Erro ao salvar", "writefile indisponível (use um executor).", 3, "error")
	end
	return ok
end

function Library:LoadConfig(filename)
	filename = filename or Config.ConfigFile
	local ok, content = pcall(function()
		if isfile and isfile(filename) then return readfile(filename) end
	end)
	if not ok or not content then
		self:Notify("Sem config", "Nenhuma configuração salva encontrada.", 3, "warning")
		return false
	end
	local ok2, data = pcall(function() return HttpService:JSONDecode(content) end)
	if not ok2 or type(data) ~= "table" then
		self:Notify("Config inválida", "O arquivo está corrompido.", 3, "error")
		return false
	end
	if type(data.Accent) == "table" then
		self:SetAccent(Color3.new(data.Accent[1], data.Accent[2], data.Accent[3]))
	end
	for k, val in pairs(data.Controls or {}) do
		local api = ControlRegistry[k]
		if api then
			pcall(function() -- Set dispara o callback, então a config realmente é aplicada
				if type(val) == "table" and val.__color then
					api.Set(Color3.new(val.r, val.g, val.b))
				elseif type(val) == "table" and val.__enum then
					api.Set(Enum.KeyCode[val.name])
				else
					api.Set(val)
				end
			end)
		end
	end
	self:Notify("Config carregada", "Suas preferências foram restauradas.", 3, "success")
	return true
end

