	}

	--//---------------------- construtor (registry → UI) -----------------------
	-- Toggles "Plain" não entram no motor (só chamam OnChange); os demais usam setActive.
	local function addControl(S, f)
		local ty = f.Type
		if ty == "Button" then
			return S:Button(f.Name, f.Callback)

		elseif ty == "Toggle" then
			local key = f.Alias or f.Id
			return S:Toggle(f.Name, f.Default, function(on)
				if f.Plain then
					if f.OnChange then f.OnChange(on) end
				else
					setActive(key, on)
				end
			end)

		elseif ty == "Slider" then
			return S:Slider(f.Name, f.Min, f.Max, f.Default, function(v)
				State.Values[f.Id] = v
				if f.Callback then f.Callback(v) end
			end, f.Step)

		elseif ty == "Dropdown" then
			return S:Dropdown(f.Name, f.Options, f.Default, function(o)
				State.Values[f.Id] = o
				if f.Callback then f.Callback(o) end
			end)

		elseif ty == "Keybind" then
			return S:Keybind(f.Name, f.Default, function()
				if f.Toggles then setActive(f.Toggles, not State.Active[f.Toggles]) end
			end, f.Changed)

		elseif ty == "ColorPicker" then
			return S:ColorPicker(f.Name, f.Default, function(c)
				State.Values[f.Id] = c
				if f.Callback then f.Callback(c) end
			end)

		elseif ty == "Label" then
			return S:Label(f.Name)
		end
		error("tipo de controle desconhecido: " .. tostring(ty))
	end

	local function buildHub()
		-- 1) pré-passada: grupos de espelhamento e valores iniciais
		for _, f in ipairs(Features) do
			if f.Type == "Toggle" and not f.Plain then
				local key = f.Alias or f.Id
				Groups[key] = Groups[key] or {}
				table.insert(Groups[key], f.Id)
				if not f.Alias then Main[key] = f end
				State.Active[key] = false
			elseif f.Default ~= nil and f.Type ~= "Keybind" and f.Type ~= "Toggle" then
				State.Values[f.Id] = f.Default
			end
		end
		State.Selected.Quest = Quests[1]

		-- 2) abas → seções → controles
		for _, tabName in ipairs(TabOrder) do
			local okTab, tab = pcall(function() return Library:CreateTab(tabName, TabIcons[tabName]) end)
			if okTab and tab then
				local sections, ordered = {}, {}
				for _, f in ipairs(Features) do
					if f.Tab == tabName then
						local title = f.Section or "Geral"
						if not sections[title] then
							sections[title] = tab:Section(title)
							table.insert(ordered, title)
						end
						local ok, res = pcall(addControl, sections[title], f)
						if ok then
							Refs[f.Id] = res
						else
							warn("[BloxHub] " .. tabName .. " / " .. tostring(f.Name) .. ": " .. tostring(res))
						end
					end
				end
			else
				warn("[BloxHub] não foi possível criar a aba " .. tabName)
			end
		end
	end

	--//------------------------- MOTOR (único Heartbeat) ------------------------
	local lastRun: { [string]: number } = {}

	local function runStep(f, dt: number)
		local ok, err = pcall(whenActive(f.Id, f.Step), dt)
		if not ok then warn("[BloxHub:" .. f.Id .. "] " .. tostring(err)) end
	end

	local function runEngine(dt: number)
		if State.Destroyed or not State.Enabled then return end
		local now = os.clock()
		for _, f in ipairs(Features) do -- for genérico sobre a registry
			if f.Step and State.Active[f.Id] then
				local interval = (f.TickKey and State.Values[f.TickKey]) or f.Tick or Config.TickDefault
				if now - (lastRun[f.Id] or 0) >= interval then
					lastRun[f.Id] = now
					if f.Inline then
						runStep(f, dt)                           -- leve: roda no próprio frame
					else
						task.spawn(runStep, f, dt)               -- pesado: não bloqueia o loop
					end
				end
			end
		end
	end

	--//------------------------------- BOOT -------------------------------------
	buildHub()
	connect(RunService.Heartbeat, runEngine)

	connect(Players.PlayerRemoving, function(plr)
		local hl, ln = ESP.Player[plr], ESP.Tracers[plr]
		if hl then pcall(destroyObj, hl); ESP.Player[plr] = nil end
		if ln then pcall(removeLine, ln); ESP.Tracers[plr] = nil end
	end)

