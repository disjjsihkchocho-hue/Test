	uiVisible = state
	if not state then closePopup() end
	Window.Visible = state
end

function Library:IsVisible() return uiVisible end

-- troca a tecla de mostrar/ocultar em runtime (aceita Enum.KeyCode ou string "Insert")
function Library:SetToggleKey(key)
	if typeof(key) == "EnumItem" and key.EnumType == Enum.KeyCode then
		Config.ToggleKey = key
	elseif type(key) == "string" then
		local ok, kc = pcall(function() return Enum.KeyCode[key] end)
		if ok and kc then Config.ToggleKey = kc end
	end
end

function Library:Destroy()
	if State.Destroyed then return end
	State.Destroyed = true
	State.Enabled = false
	closePopup()
	for _, hook in ipairs(DestroyHooks) do pcall(hook) end -- ESP, anti-AFK, etc.
	for _, c in ipairs(Connections) do pcall(function() c:Disconnect() end) end
	table.clear(Connections)
	if ScreenGui then ScreenGui:Destroy() end
	if env.BloxHubUI == Library then env.BloxHubUI = nil end
end

