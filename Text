		connect(box.MouseButton1Click, function()
			buildOptions()
			list.Size = UDim2.fromOffset(box.AbsoluteSize.X / WinScale.Scale, math.min(#options * 24 + 8, 156))
			tween(arrow, 0.15, { Rotation = 180 })
			openPopup(list, box, function() tween(arrow, 0.15, { Rotation = 0 }) end)
		end)

		local api = {
			Set = function(v, silent) setSelected(v, not silent) end,
			Get = function() return selected end,
			SetOptions = function(newOptions, keep)
				options = newOptions or {}
				if not (keep and table.find(options, selected)) then
					setSelected(options[1], false)
				end
			end,
		}
		registerControl(key(text), api)
		return api
	end

