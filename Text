	end

	-- auto-load
	local okAuto, autoOn = pcall(function()
		return isfile and readfile and isfile(Config.AutoLoadFile) and readfile(Config.AutoLoadFile) == "1"
	end)
	if okAuto and autoOn then
		if Refs.AutoLoad then Refs.AutoLoad.Set(true, true) end
		task.delay(1.5, function() Library:LoadConfig() end)
	end

	-- introdução
	Library:Notify(Config.Brand .. " " .. Config.BrandSub, Config.Version .. " carregado", 4, "success")

	Library.State, Library.Features, Library.Refs = State, Features, Refs
end

