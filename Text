			v = 1 - math.clamp((input.Position.Y - sv.AbsolutePosition.Y) / math.max(1, sv.AbsoluteSize.Y), 0, 1)
			refresh(true)
		end
		local function fromHue(input)
			h = math.clamp((input.Position.X - hue.AbsolutePosition.X) / math.max(1, hue.AbsoluteSize.X), 0, 1)
			refresh(true)
		end
		dragify(sv, fromSV, fromSV)
		dragify(hue, fromHue, fromHue)

